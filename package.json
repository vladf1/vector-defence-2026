{
  "name": "vector-defence-browser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "^1.4.4"
  },
  "scripts": {
    "dev": "vite",
    "check:runtime": "bun scripts/check-runtime.mjs",
    "benchmark:draw": "bun scripts/benchmark-draw-methods.mjs",
    "benchmark:draw:towers": "bun scripts/benchmark-draw-methods.mjs --tower-profile",
    "benchmark:death-effects": "bun scripts/benchmark-death-effects.mjs",
    "benchmark:update": "bun scripts/benchmark-update-methods.mjs",
    "render:levels": "bun scripts/render-levels.mjs",
    "render:towers": "bun scripts/render-towers.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:pages": "tsc --noEmit -p tsconfig.json && vite build --base=/vector-defence-2026/",
    "preview": "vite preview"
  },
  "trustedDependencies": [
    "fsevents"
  ],
  "devDependencies": {
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
